  "ingredients": [
    {
      "section": "Main",
      "items": [
        "750 g boneless chicken thighs, cut into bite-sized pieces",
        "2 large onions, thinly sliced",
        "2–3 medium tomatoes, finely chopped",
        "3 tbsp ghee",
        "4 garlic cloves, finely chopped",
        "1½ tsp ginger paste",
        "1 tsp cumin seeds",
        "1 tsp coriander seeds, lightly crushed",
        "3–4 green chilies, slit",
        "1 tsp turmeric powder",
        "1 tsp Kashmiri red chili powder",
        "Salt to taste",
        "1 cup plain yogurt, whisked",
        "2 tsp kasuri methi (dried fenugreek leaves)",
        "1 tsp garam masala",
        "½ cup heavy cream (optional)"
      ]
    }
  ],
  "instructions": [
    "Heat the ghee in a heavy-bottomed handi or deep pan over medium heat.",
    "Add the sliced onions and cook slowly until they become deep golden brown. Remove and reserve the onions.",
    "In the same ghee, sauté the chopped garlic for about 30 seconds.",
    "Add the chopped tomatoes and cook until they completely soften and begin releasing oil.",
    "Return the caramelized onions to the pan and mix well.",
    "Stir in the ginger paste and cook for 1 minute.",
    "Add the cumin seeds, crushed coriander seeds, and slit green chilies.",
    "Mix in the turmeric, Kashmiri red chili powder, and salt.",
    "Add the chicken pieces and sauté over medium-high heat until lightly browned on all sides.",
    "Cover and cook for about 5 minutes, allowing the chicken to release its juices.",
    "Reduce the heat to low and gradually stir in the whisked yogurt to prevent curdling.",
    "Cook uncovered for another 8–10 minutes until the gravy thickens and the chicken is fully cooked.",
    "Finish with crushed kasuri methi and garam masala.",
    "For a richer restaurant-style finish, stir in the heavy cream during the final 2 minutes of cooking.",
    "Rest for 5 minutes before serving."
  ],
  "notes": [
    "Chicken thighs stay juicier than breast meat.",
    "Cook the onions slowly until deep golden for the best flavor.",
    "Whisk the yogurt well and add it over low heat to avoid splitting.",
    "The cream is optional but gives a richer restaurant-style finish."
  ],
